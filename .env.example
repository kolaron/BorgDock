# BorgDock Environment Variables Template
# Copy to .env.local and customize (will be gitignored)

# USB Backup Disk
BACKUP_DISK_UUID=your-disk-uuid-here
BACKUP_MOUNT_PATH=/mnt/backup

# Borg Repository
BORG_REPO_PATH=/mnt/backup/borg-repo
BORG_SOURCE_1=/home
BORG_SOURCE_2=/etc
BORG_COMPRESSION=zstd,8

# Scheduling (cron format: minute hour day month weekday)
CRON="0 2 * * *"

# Timezone
TZ=UTC
